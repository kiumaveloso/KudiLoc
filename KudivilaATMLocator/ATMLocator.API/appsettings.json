{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://kudiloc.com",
      "https://www.kudiloc.com",
      "https://app.kudiloc.com"
    ]
  },
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "KudiLoc",
    "ATMsCollectionName": "atms",
    "StatusReportsCollectionName": "status_reports",
    "UsersCollectionName": "users",
    "CommentsCollectionName": "comments",
    "BadgesCollectionName": "badges",
    "VisitHistoryCollectionName": "visit_history",
    "RefreshTokensCollectionName": "refresh_tokens",
    "OtpCollectionName": "otp_entries",
    "LoginAuditsCollectionName": "login_audits"
  },
  "Jwt": {
    "Key": "YourSuperSecretKeyThatIsAtLeast32CharactersLongForProduction!",
    "Issuer": "KudiLoc",
    "Audience": "KudiLoc",
    "ExpirationDays": 30,
    "AccessTokenMinutes": 15
  },
  "ATMSettings": {
    "InitialReliabilityScore": 50,
    "MinReliabilityScore": 30,
    "DefaultSearchRadiusKm": 5.0,
    "FallbackSearchRadiusKm": 10.0,
    "WalkingMinutesPerKm": 12
  },
  "ReportSettings": {
    "ReportTimeWindowMinutes": 30,
    "MinConfirmationsForTrust": 3,
    "CooldownMinutes": 5,
    "ReputationGainOnConsensus": 2,
    "ReputationLossOnDisagreement": 3,
    "ConsensusCheckWindowMinutes": 5
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "Encryption": {
    "Key": "",
    "HmacKey": ""
  },
  "AfricasTalking": {
    "ApiKey": "",
    "Username": "",
    "SenderId": "KudiLoc"
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Demo": {
    "PhoneNumbers": [
      "+244912345678"
    ]
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Forwarded-For",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "QuotaExceededResponse": {
      "Content": "{{ \"error\": \"Limite de requisicoes excedido. Tente novamente mais tarde.\", \"retryAfter\": \"{0}\" }}",
      "ContentType": "application/json",
      "StatusCode": 429
    },
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1m", "Limit": 120 },
      { "Endpoint": "*", "Period": "1h", "Limit": 2000 },
      { "Endpoint": "get:/api/ATM/nearby", "Period": "1m", "Limit": 30 },
      { "Endpoint": "get:/api/ATM/province/*", "Period": "1m", "Limit": 20 },
      { "Endpoint": "get:/api/ATM/search", "Period": "1m", "Limit": 30 },
      { "Endpoint": "post:/api/StatusReport", "Period": "1m", "Limit": 10 },
      { "Endpoint": "post:/api/Auth/register", "Period": "1m", "Limit": 5 },
      { "Endpoint": "post:/api/Auth/login", "Period": "1m", "Limit": 10 },
      { "Endpoint": "post:/api/ATM", "Period": "1m", "Limit": 5 },
      { "Endpoint": "post:/api/ATM/*/photo", "Period": "1m", "Limit": 5 },
      { "Endpoint": "post:/api/Auth/otp/request", "Period": "1m", "Limit": 5 },
      { "Endpoint": "post:/api/Auth/otp/verify", "Period": "1m", "Limit": 10 }
    ]
  }
}
