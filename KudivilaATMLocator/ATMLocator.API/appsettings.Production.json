{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "MongoDbSettings": {
    "ConnectionString": "REPLACE_WITH_PRODUCTION_CONNECTION_STRING",
    "DatabaseName": "KudiLoc"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_PRODUCTION_SECRET_KEY_AT_LEAST_32_CHARS",
    "ExpirationDays": 7
  },
  "IpRateLimiting": {
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1m", "Limit": 60 },
      { "Endpoint": "*", "Period": "1h", "Limit": 500 },
      { "Endpoint": "post:/api/StatusReport", "Period": "1m", "Limit": 5 },
      { "Endpoint": "post:/api/Auth/register", "Period": "1m", "Limit": 3 },
      { "Endpoint": "post:/api/Auth/login", "Period": "1m", "Limit": 5 },
      { "Endpoint": "post:/api/Auth/otp/request", "Period": "1m", "Limit": 2 },
      { "Endpoint": "post:/api/Auth/otp/verify", "Period": "1m", "Limit": 3 }
    ]
  }
}
